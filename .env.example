VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of your backend proxy that talks to Amadeus (never call Amadeus directly from the browser
# — GDS credentials and the SOAP/WS-Security session must stay server-side).
# The frontend POSTs to {VITE_PNR_API_URL}/pnr/lookup with { "flightCode": "AA204" } and expects back
# either 404 (not found) or 200 with:
# { "pnr": "ABC123", "airline": "American Airlines", "flightCode": "AA204", "route": "JFK", "dest": "LAX",
#   "date": "Oct 15, 2026", "time": "10:15 AM", "arrTime": "01:45 PM" }
VITE_PNR_API_URL=

# Sabre REST API — TEST/sandbox only (https://developer.sabre.com). Will change later.
# VITE_* values ship in the client bundle — never put production secrets here.
VITE_SABRE_BASE_URL=https://api.sabre.com
VITE_SABRE_KEY=
VITE_SABRE_SECRET=
# Optional pre-issued bearer token (used first; auto-refreshed via POST /v2/auth/token on 401)
VITE_SABRE_TOKEN=
